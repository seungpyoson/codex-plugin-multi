{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/relay/provider-parity-table.schema.json",
  "title": "Provider Architecture Parity Table",
  "type": "object",
  "required": ["schema_version", "feature", "providers", "policy_areas", "concurrency_budget", "semantic_drift_policy", "issue_fit", "guardrail_tests"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "feature": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string" },
    "providers": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "claude" } },
        { "contains": { "const": "gemini" } },
        { "contains": { "const": "kimi" } },
        { "contains": { "const": "agy" } },
        { "contains": { "const": "grok" } },
        { "contains": { "const": "deepseek" } },
        { "contains": { "const": "glm" } }
      ],
      "items": {
        "enum": ["claude", "gemini", "kimi", "agy", "grok", "deepseek", "glm"]
      },
      "minItems": 7
    },
    "policy_areas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy_area" }
    },
    "concurrency_budget": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/concurrency_fact" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapter_exception" }
    },
    "semantic_drift_policy": { "$ref": "#/$defs/semantic_drift_policy" },
    "issue_fit": { "$ref": "#/$defs/issue_fit" },
    "verification": {
      "type": "array",
      "items": { "$ref": "#/$defs/verification" }
    },
    "guardrail_tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/guardrail_test" }
    }
  },
  "$defs": {
    "concurrency_fact": {
      "type": "object",
      "required": ["provider", "route", "category", "limit"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "category": { "enum": ["shared_state", "stateless"] },
        "limit": { "type": "integer", "minimum": 1 },
        "limit_env": { "type": ["string", "null"] }
      }
    },
    "policy_area": {
      "type": "object",
      "required": ["name", "module", "interface", "implementation", "adapters", "tests", "verdict"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "interface": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 },
        "adapters": { "type": "array", "items": { "type": "string" } },
        "packaged_copies": { "type": ["array", "null"], "items": { "type": "string" } },
        "sync_guard": { "type": ["string", "null"] },
        "tests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "verdict": {
          "enum": [
            "compliant_shared_policy",
            "intentional_adapter_exception",
            "accidental_provider_specific_policy",
            "packaging_copy_with_sync_guard",
            "packaging_copy_without_sufficient_sync_guard",
            "unknown_needs_research"
          ]
        },
        "drift_risk": { "enum": ["low", "medium", "high"] },
        "missing_guardrail": { "type": ["string", "null"] }
      }
    },
    "adapter_exception": {
      "type": "object",
      "required": [
        "provider",
        "policy_area",
        "difference_type",
        "current_behavior",
        "shared_policy_boundary",
        "clear_reason",
        "evidence",
        "tests",
        "verdict",
        "follow_up_issue"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["claude", "gemini", "kimi", "agy", "grok", "deepseek", "glm"] },
        "policy_area": { "type": "string" },
        "difference_type": {
          "enum": [
            "adapter_capability_fact",
            "documented_policy_exception",
            "known_accidental_drift",
            "research_gap"
          ]
        },
        "current_behavior": { "type": "string" },
        "capability_fact": { "type": ["string", "null"] },
        "shared_policy_boundary": { "type": "string", "minLength": 1 },
        "clear_reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tests": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "verdict": { "enum": ["intentional", "accidental", "unknown"] },
        "follow_up_issue": { "type": ["integer", "null"] }
      }
    },
    "semantic_drift_policy": {
      "type": "object",
      "required": [
        "standard",
        "allowed_intentional_difference_types",
        "tracked_noncompliance_types",
        "required_exception_fields"
      ],
      "additionalProperties": false,
      "properties": {
        "standard": { "type": "string", "minLength": 1 },
        "allowed_intentional_difference_types": {
          "type": "array",
          "items": { "enum": ["adapter_capability_fact", "documented_policy_exception"] },
          "minItems": 2,
          "uniqueItems": true
        },
        "tracked_noncompliance_types": {
          "type": "array",
          "items": { "enum": ["known_accidental_drift", "research_gap"] },
          "minItems": 2,
          "uniqueItems": true
        },
        "required_exception_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "issue_fit": {
      "type": "object",
      "required": ["primary_issue", "evidence_issue", "new_issue_required"],
      "additionalProperties": false,
      "properties": {
        "primary_issue": { "const": 171 },
        "evidence_issue": { "const": 170 },
        "related_issues": { "type": "array", "items": { "type": "integer" } },
        "new_issue_required": { "type": "boolean" },
        "split_recommendation": { "type": ["string", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "required": ["command", "status"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string" },
        "status": { "enum": ["passed", "failed", "not_run"] },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "guardrail_test": {
      "type": "object",
      "required": ["name", "file", "purpose", "red_condition", "green_condition", "verification_command"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "red_condition": { "type": "string", "minLength": 1 },
        "green_condition": { "type": "string", "minLength": 1 },
        "verification_command": { "type": "string", "minLength": 1 },
        "required_fields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_interfaces": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "required_entrypoints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
