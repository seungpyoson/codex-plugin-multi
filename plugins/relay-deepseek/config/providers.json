{
  "deepseek": {
    "display_name": "DeepSeek",
    "auth_mode": "api_key",
    "env_keys": [
      "DEEPSEEK_API_KEY"
    ],
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-v4-pro",
    "max_prompt_chars": 600000,
    "request_defaults": {
      "thinking": {
        "type": "enabled"
      },
      "reasoning_effort": "max",
      "max_tokens": 65536
    }
  }
}
