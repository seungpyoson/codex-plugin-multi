{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credential-resolution.schema.json",
  "title": "Direct API Credential Resolution Fields",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "credential_ref": {
      "type": ["string", "null"]
    },
    "credential_source": {
      "type": ["string", "null"],
      "enum": ["env", "env_cache", null]
    },
    "auth_path": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth_mode": {
          "type": ["string", "null"]
        },
        "credential_ref": {
          "type": ["string", "null"]
        },
        "credential_source": {
          "type": ["string", "null"],
          "enum": ["env", "env_cache", null]
        }
      },
      "required": ["auth_mode", "credential_ref", "credential_source"]
    }
  }
}
